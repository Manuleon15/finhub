# ===== BACKEND =====
API_KEY=finhub-dev-key-change-me
DATABASE_URL=sqlite:///./finhub.db
FX_USD_EUR=0.92
CACHE_TTL_SECONDS=900
LLM_ENABLED=false
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
LLM_API_KEY=
SCHEDULER_ENABLED=true
WATCHLIST=MSFT,ADBE,NVDA,GOOG,AMZN,CRM,NVO,AAPL,TSLA,META
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== FRONTEND (copiar a frontend/.env.local) =====
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=finhub-dev-key-change-me

# ===== NEXTAUTH (Google OAuth) =====
# Obtener en: https://console.cloud.google.com/ > APIs & Services > Credentials
AUTH_GOOGLE_ID=tu-google-client-id
AUTH_GOOGLE_SECRET=tu-google-client-secret
AUTH_SECRET=genera-uno-aleatorio-largo-aqui
# Emails con acceso (separados por coma). Solo estos pueden entrar.
ALLOWED_EMAILS=tu-email@gmail.com

